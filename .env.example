# Risk engine: mock (default) or remote
RISK_PROVIDER=mock
RISK_ENGINE_URL=http://localhost:8000
# Teammate handoff's compatible bank-transfer endpoint. Keep /behavior/analyze
# for Sparkov fixture evaluation only; it requires merchant geo/source fields.
RISK_ENGINE_PATH=/analyze
# Demo-only fixture profile from the teammate engine. Do not set in production.
RISK_ENGINE_DEMO_USER_ID=
RISK_ENGINE_TIMEOUT_MS=3000
RISK_FALLBACK_TO_MOCK=true
# Payments under this USD amount never open a customer intervention in demo mode.
GUARDIAN_INTERVENTION_FLOOR_USD=100

# Gemini is optional in demo mode; deterministic agent fallback remains available.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Explicitly label the environment as a fictional demo.
NEXT_PUBLIC_DEMO_MODE=true

# Headless Guardian API. If GUARDIAN_API_KEY is empty, local demo requests are allowed.
GUARDIAN_API_KEY=
GUARDIAN_ALLOWED_ORIGIN=http://localhost:3000
GUARDIAN_DECISION_WEBHOOK_URL=
GUARDIAN_WEBHOOK_SECRET=
